#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROS_DISTRO_NAME="${ROS_DISTRO:-jazzy}"

usage() {
  cat <<EOF
用法:
  ./quick.start          # 显示启动菜单
  ./quick.start <序号>   # 直接启动某一项

启动项:
  1  recap 数采节点              recap 推理 rollout 专用；只启动 recap_mcap_recorder
  2  普通 MCAP 数采              专家遥操 / 通用 MCAP；启动 mcap_recorder.launch.py
  3  legacy 旧版落盘             multi_subscriber；PNG + CSV fallback 路径
  4  recap 一体化启动            recap 数采 + no-subtask 推理 launch
  0  退出

序号后面的额外参数会原样传给对应命令。
默认会先 colcon build 相关包，确保 src/config 修改同步到 install。
如需跳过编译: QUICK_START_SKIP_BUILD=1 ./quick.start <序号>
LeRobot 自动转换可在启动普通 MCAP 数采时交互选择，也可用
QUICK_START_LEROBOT_CONVERSION=true/false/config 预设。
MCAP 数据大小限制可在启动时选择默认范围、自定义范围或关闭，也可用
QUICK_START_EPISODE_SIZE_LIMIT=true/false 预设。自定义上下限可用
QUICK_START_MINIMUM_EPISODE_SIZE_MB / QUICK_START_MAXIMUM_EPISODE_SIZE_MB 预设。
示例:
  ./quick.start 2 output_dir:=/tmp/raw_datasets_mcap
  ./quick.start 2 lerobot_conversion_enabled:=false
  QUICK_START_EPISODE_SIZE_LIMIT=false ./quick.start 2
  ./quick.start 3 --ros-args -p use_compressed_images:=true
EOF
}

source_ros() {
  local ros_setup="/opt/ros/${ROS_DISTRO_NAME}/setup.bash"
  if [[ ! -f "${ros_setup}" ]]; then
    echo "错误: 找不到 ${ros_setup}。请设置 ROS_DISTRO，或先安装 ROS 2。" >&2
    exit 1
  fi
  source_setup "${ros_setup}"
}

source_workspace() {
  if [[ -f "${ROOT}/install/setup.bash" ]]; then
    source_setup "${ROOT}/install/setup.bash"
  elif [[ -f "${ROOT}/install/local_setup.bash" ]]; then
    source_setup "${ROOT}/install/local_setup.bash"
  else
    echo "错误: 找不到工作区 install/setup.bash。请先在仓库根目录运行 colcon build。" >&2
    exit 1
  fi
}

build_workspace_packages() {
  if [[ "${QUICK_START_SKIP_BUILD:-0}" == "1" ]]; then
    echo "跳过编译: QUICK_START_SKIP_BUILD=1"
    return
  fi

  if ! command -v colcon >/dev/null 2>&1; then
    echo "错误: 找不到 colcon，无法编译工作区。" >&2
    exit 1
  fi

  echo "编译工作区包: $*"
  (
    cd "${ROOT}"
    colcon build --symlink-install --packages-select "$@"
  )
}

source_setup() {
  local setup_file="$1"
  local restore_nounset=false

  case "$-" in
    *u*)
      restore_nounset=true
      set +u
      ;;
  esac

  # shellcheck source=/dev/null
  source "${setup_file}"

  if [[ "${restore_nounset}" == true ]]; then
    set -u
  fi
}

run_ros_package() {
  source_ros
  build_workspace_packages "$@"
  source_workspace
}

run_recap_recorder() {
  run_ros_package data_collection_core data_collection_recorder data_collection_recap_recorder
  if ! has_episode_size_limit_arg "$@"; then
    local size_limit_mode minimum_size_mb maximum_size_mb
    read -r size_limit_mode minimum_size_mb maximum_size_mb \
      <<< "$(choose_episode_size_limit_config)"
    if has_ros_args_marker "$@"; then
      set -- "$@" \
        "-p" "episode_size_limit_enabled:=${size_limit_mode}" \
        "-p" "minimum_episode_size_mb:=${minimum_size_mb}" \
        "-p" "maximum_episode_size_mb:=${maximum_size_mb}"
    else
      set -- "--ros-args" \
        "-p" "episode_size_limit_enabled:=${size_limit_mode}" \
        "-p" "minimum_episode_size_mb:=${minimum_size_mb}" \
        "-p" "maximum_episode_size_mb:=${maximum_size_mb}" "$@"
    fi
  fi
  exec ros2 run data_collection_recap_recorder recap_mcap_recorder "$@"
}

has_episode_size_limit_arg() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      episode_size_limit_enabled:=*|minimum_episode_size_mb:=*|maximum_episode_size_mb:=*)
        return 0
        ;;
    esac
  done
  return 1
}

has_ros_args_marker() {
  local arg
  for arg in "$@"; do
    if [[ "${arg}" == "--ros-args" ]]; then
      return 0
    fi
  done
  return 1
}

is_nonnegative_number() {
  [[ "$1" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]
}

is_valid_size_range() {
  awk -v minimum="$1" -v maximum="$2" \
    'BEGIN { exit !(minimum >= 0 && maximum >= minimum) }'
}

normalize_decimal() {
  if [[ "$1" == *.* ]]; then
    printf '%s' "$1"
  else
    printf '%s.0' "$1"
  fi
}

choose_episode_size_limit_config() {
  local default_minimum_raw="${QUICK_START_MINIMUM_EPISODE_SIZE_MB:-108.0}"
  local default_maximum_raw="${QUICK_START_MAXIMUM_EPISODE_SIZE_MB:-145.0}"

  if ! is_nonnegative_number "${default_minimum_raw}" \
    || ! is_nonnegative_number "${default_maximum_raw}" \
    || ! is_valid_size_range "${default_minimum_raw}" "${default_maximum_raw}"; then
    echo "错误: 环境变量中的数据大小上下限无效。" >&2
    exit 2
  fi
  local default_minimum default_maximum
  default_minimum="$(normalize_decimal "${default_minimum_raw}")"
  default_maximum="$(normalize_decimal "${default_maximum_raw}")"

  if [[ -n "${QUICK_START_EPISODE_SIZE_LIMIT:-}" ]]; then
    case "${QUICK_START_EPISODE_SIZE_LIMIT}" in
      0|off|OFF|false|FALSE|no|NO)
        printf 'false %s %s' "${default_minimum}" "${default_maximum}"
        ;;
      *)
        printf 'true %s %s' "${default_minimum}" "${default_maximum}"
        ;;
    esac
    return
  fi

  if [[ ! -t 0 ]]; then
    printf 'true %s %s' "${default_minimum}" "${default_maximum}"
    return
  fi

  cat >&2 <<EOF

MCAP 数据大小限制（本次启动）:
  1  使用默认范围：108–145 MB（默认）
  2  自定义上下限
  3  关闭：不检查上一段数据大小

请选择 [1/2/3，默认 1]:
EOF
  local choice
  read -r choice
  case "${choice}" in
    2)
      local minimum_size_mb maximum_size_mb
      while true; do
        printf '请输入下限 MB（默认 108）: ' >&2
        read -r minimum_size_mb
        minimum_size_mb="${minimum_size_mb:-108.0}"
        printf '请输入上限 MB（默认 145）: ' >&2
        read -r maximum_size_mb
        maximum_size_mb="${maximum_size_mb:-145.0}"

        if ! is_nonnegative_number "${minimum_size_mb}" \
          || ! is_nonnegative_number "${maximum_size_mb}"; then
          echo "输入无效：上下限必须是大于或等于 0 的数字，请重新输入。" >&2
          continue
        fi
        if ! is_valid_size_range "${minimum_size_mb}" "${maximum_size_mb}"; then
          echo "输入无效：上限不能小于下限，请重新输入。" >&2
          continue
        fi
        minimum_size_mb="$(normalize_decimal "${minimum_size_mb}")"
        maximum_size_mb="$(normalize_decimal "${maximum_size_mb}")"
        printf 'true %s %s' "${minimum_size_mb}" "${maximum_size_mb}"
        return
      done
      ;;
    3|off|OFF|false|FALSE|no|NO)
      printf 'false %s %s' "${default_minimum}" "${default_maximum}"
      ;;
    *)
      printf 'true %s %s' "${default_minimum}" "${default_maximum}"
      ;;
  esac
}

has_lerobot_conversion_arg() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      lerobot_conversion_enabled:=*) return 0 ;;
    esac
  done
  return 1
}

choose_lerobot_conversion_mode() {
  if [[ -n "${QUICK_START_LEROBOT_CONVERSION:-}" ]]; then
    printf '%s' "${QUICK_START_LEROBOT_CONVERSION}"
    return
  fi

  if [[ ! -t 0 ]]; then
    printf 'config'
    return
  fi

  cat >&2 <<EOF

LeRobot 自动转换（本次启动）:
  1  关闭（推荐采集优先）
  2  开启（后台低优先级转换）
  3  跟随配置文件

请选择 [1/2/3，默认 1]: 
EOF
  local choice
  read -r choice
  case "${choice}" in
    2|on|ON|true|TRUE|yes|YES) printf 'true' ;;
    3|config|CONFIG|default|DEFAULT) printf 'config' ;;
    *) printf 'false' ;;
  esac
}

run_mcap_recorder() {
  run_ros_package data_collection_core data_collection_recorder
  if ! has_episode_size_limit_arg "$@"; then
    local size_limit_mode minimum_size_mb maximum_size_mb
    read -r size_limit_mode minimum_size_mb maximum_size_mb \
      <<< "$(choose_episode_size_limit_config)"
    set -- \
      "episode_size_limit_enabled:=${size_limit_mode}" \
      "minimum_episode_size_mb:=${minimum_size_mb}" \
      "maximum_episode_size_mb:=${maximum_size_mb}" "$@"
  fi
  if ! has_lerobot_conversion_arg "$@"; then
    local conversion_mode
    conversion_mode="$(choose_lerobot_conversion_mode)"
    if [[ "${conversion_mode}" != "config" ]]; then
      set -- "lerobot_conversion_enabled:=${conversion_mode}" "$@"
    fi
  fi
  exec ros2 launch data_collection_recorder mcap_recorder.launch.py "$@"
}

run_multi_subscriber() {
  run_ros_package multi_subscriber
  exec ros2 run multi_subscriber multi_topic_subscriber "$@"
}

run_recap_full_launch() {
  run_ros_package data_collection_core data_collection_recorder data_collection_recap_recorder
  if ! has_episode_size_limit_arg "$@"; then
    local size_limit_mode minimum_size_mb maximum_size_mb
    read -r size_limit_mode minimum_size_mb maximum_size_mb \
      <<< "$(choose_episode_size_limit_config)"
    set -- \
      "episode_size_limit_enabled:=${size_limit_mode}" \
      "minimum_episode_size_mb:=${minimum_size_mb}" \
      "maximum_episode_size_mb:=${maximum_size_mb}" "$@"
  fi
  exec ros2 launch data_collection_recap_recorder recap_inference_collection.launch.py "$@"
}

choose() {
  local choice="${1:-}"
  shift || true

  case "${choice}" in
    1) run_recap_recorder "$@" ;;
    2) run_mcap_recorder "$@" ;;
    3) run_multi_subscriber "$@" ;;
    4) run_recap_full_launch "$@" ;;
    0|q|Q|exit) exit 0 ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      echo "错误: 未知启动序号 '${choice}'。" >&2
      echo >&2
      usage >&2
      exit 2
      ;;
  esac
}

if [[ $# -gt 0 ]]; then
  choose "$@"
  exit 0
fi

usage
printf "\n请输入启动序号: "
read -r choice
choose "${choice}"
